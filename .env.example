MIRAGE_ENV=development
MIRAGE_MODE=local_research
MIRAGE_DATABASE_PATH=./data/mirage.db
MIRAGE_LOG_LEVEL=INFO
MIRAGE_MAX_DATASET_EXAMPLES=1000
MIRAGE_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct
MIRAGE_FALLBACK_MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
MIRAGE_NLI_MODEL_NAME=cross-encoder/nli-deberta-v3-small
MIRAGE_DEVICE=auto
MIRAGE_MAX_NEW_TOKENS=180
MIRAGE_DEFAULT_SAMPLE_COUNT=6
MIRAGE_MAX_SAMPLE_COUNT=10
MIRAGE_SAMPLE_CONCURRENCY=2
MIRAGE_NLI_THRESHOLD=0.70
MIRAGE_ENABLE_DEMO_MODE=true
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
VITE_API_BASE_URL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_SUPPORTS_LOGPROBS=false
MIRAGE_PROVIDER_TIMEOUT=120
MIRAGE_MAX_PARALLEL_REQUESTS=1
MIRAGE_REQUESTS_PER_MINUTE=30
MIRAGE_BOOTSTRAP_RESAMPLES=1000
MIRAGE_EMBEDDING_MODEL=all-minilm
